# API en vivo de Krispy Gestiones (desplegada en Fly.io) — aquí es donde el scraper
# manda cada resultado. En local, apunta a tu backend corriendo en localhost.
KG_API_BASE_URL=https://TU-APP.fly.dev
KG_API_KEY=

SCRAPER_ENABLED=True
SCRAPER_LOG_LEVEL=INFO
SCRAPER_TIMEOUT=30
SCRAPER_RETRY_MAX=3

# Cuántas instancias de daemon.py lanza iniciar_daemon.bat en paralelo en ESTA máquina
# (reparten el trabajo entre ellas, ver scheduler.py). Déjalo sin poner (o en 1) en el
# portátil de trabajo que corre 24/7 -- comportamiento de siempre. Súbelo a 6-8 solo en
# una máquina más potente que enciendas puntualmente como refuerzo en paralelo.
# SCRAPER_WORKERS=1
